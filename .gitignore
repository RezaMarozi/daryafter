# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---- this computer's Python environment and downloaded libraries ----------
# (run.bat rebuilds .venv; Libs holds big .whl files, too large for Git)
.venv/
venv/
Libs/

# ---- personal data: never publish these -----------------------------------
# portable mode keeps its database, settings and log here
data/
portable.flag
# the database holds the download list, settings and the app-lock password hash
*.db
*.db-wal
*.db-shm
*.log
.env

# ---- build output ---------------------------------------------------------
/build/
/dist/
/build-appimage/
*.spec

# ---- AppImage -------------------------------------------------------------
/appimage_entry.py
/AppDir/
/*.AppImage
*.AppImage.zsync

# ---- browser extension build output ---------------------------------------
*.xpi

# ---- local packaging build artifacts --------------------------------------
packaging/src/
packaging/pkg/
packaging/deb-root/
packaging/rpm-build/
packaging/*.tar.gz
packaging/*.pkg.tar.zst
# local-only makepkg wrapper used to build the package from the working tree
packaging/PKGBUILD.local

# ---- editors and Windows --------------------------------------------------
.vscode/
.idea/
Thumbs.db
Desktop.ini
