# Daryafter - free, open-source multi-connection download manager.
# Upstream: https://github.com/RezaMarozi/daryafter
#
# The source is pinned to the commit that carries version 0.1.1 (the v0.1.1
# tag does not exist upstream yet). Once the tag is pushed, switch back to:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# and update sha256sums (a tag tarball extracts as "$pkgname-$pkgver").

pkgname=daryafter
pkgver=0.1.1
pkgrel=1
pkgdesc="Free, open-source multi-connection download manager"
arch=('any')
url="https://github.com/RezaMarozi/daryafter"
license=('MIT')
depends=(
    'python'
    'pyside6'
    'qt6-wayland'
    'python-httpx'
    'python-h2'
    'python-socksio'
    'python-truststore'
)
optdepends=(
    'libnotify: desktop notification fallback via notify-send'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-setuptools'
)
_commit=23ce17690ee7c4e0db40f9050766997e3264808d
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit/$pkgname-$pkgver.tar.gz")
sha256sums=('fa284cb96cadddf19b5b1a2e3d1f317c70eb28f03f821e3d6bdbb812d1e067c8')

build() {
    cd "$srcdir/$pkgname-$_commit"
    /usr/bin/python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname-$_commit"

    /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
    find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} +
    find "$pkgdir" -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete

    install -Dm644 packaging/daryafter.desktop \
        "$pkgdir/usr/share/applications/daryafter.desktop"

    install -Dm644 packaging/daryafter.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/daryafter.svg"

    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
