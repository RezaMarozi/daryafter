# Daryafter - free, open-source multi-connection download manager.
# Maintainer: AMIRKATE <amirkateb36@gmail.com>
# Upstream: https://github.com/RezaMarozi/daryafter
#
# The source is pinned to the commit that carries version 0.1.1 (the v0.1.1
# tag does not exist upstream yet). Once the tag is pushed, switch back to:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# and update sha256sums (a tag tarball extracts as "$pkgname-$pkgver").
#
# NOTE: this PKGBUILD installs the browser extension and the native messaging
# host (extension/ + packaging/daryafter-native-host.json), which the pinned
# commit does not contain yet. Re-pin _commit to the commit that carries the
# browser-extension work (or the release tag) before publishing to the AUR.

pkgname=daryafter
pkgver=0.1.1
pkgrel=3
pkgdesc="Free, open-source multi-connection download manager"
arch=('any')
url="https://github.com/RezaMarozi/daryafter"
license=('MIT')
depends=(
    'python'
    'pyside6'
    'qt6-wayland'
    'python-httpx'
    'python-h2'
    'python-socksio'
    'python-truststore'
    'hicolor-icon-theme'
)
optdepends=(
    'libnotify: desktop notification fallback via notify-send'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-setuptools'
)
_commit=23ce17690ee7c4e0db40f9050766997e3264808d
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit/$pkgname-$pkgver.tar.gz")
sha256sums=('fa284cb96cadddf19b5b1a2e3d1f317c70eb28f03f821e3d6bdbb812d1e067c8')

build() {
    cd "$srcdir/$pkgname-$_commit"
    /usr/bin/python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname-$_commit"

    /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
    find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} +
    find "$pkgdir" -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete

    install -Dm644 packaging/daryafter.desktop \
        "$pkgdir/usr/share/applications/daryafter.desktop"

    install -Dm644 packaging/daryafter.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/daryafter.svg"

    # Browser extension: both builds are assembled from extension/src/ plus
    # the per-browser manifest, so the package ships exactly what the build
    # script produced (and the ZIPs users can load directly).
    /usr/bin/python extension/build.py --output "$srcdir/extension-build"
    install -d "$pkgdir/usr/share/daryafter/extensions"
    cp -r "$srcdir/extension-build/firefox" \
          "$srcdir/extension-build/chrome" \
          "$pkgdir/usr/share/daryafter/extensions/"
    install -m644 "$srcdir/extension-build/"daryafter-*.zip \
        "$pkgdir/usr/share/daryafter/extensions/"

    # Native messaging host: lets the browser extension start Daryafter when
    # it is not running. The Firefox manifest is system-wide; for Chrome/
    # Chromium the manifest needs the extension's ID, so users run
    # /usr/share/daryafter/native-host/install.sh with CHROME_ID set.
    install -Dm755 extension/native-host/daryafter_native_host.py \
        "$pkgdir/usr/lib/daryafter/daryafter-native-host"
    install -Dm755 extension/native-host/install.sh \
        "$pkgdir/usr/share/daryafter/native-host/install.sh"
    install -Dm644 packaging/daryafter-native-host.json \
        "$pkgdir/usr/lib/mozilla/native-messaging-hosts/daryafter.json"
    chmod -R u=rwX,go=rX "$pkgdir/usr/share/daryafter/extensions" \
                            "$pkgdir/usr/share/daryafter/native-host"

    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
